vocabulary <http://example.com/LeaderOntology/vocabulary/questionnaire#> as questionnaire {
	
	extends <http://example.com/LeaderOntology/vocabulary/base#> as base
	extends <http://example.com/LeaderOntology/vocabulary/competencies#> as competencies
	extends <http://example.com/LeaderOntology/vocabulary/leadershipStyles#> as leadershipStyles
	extends <http://example.com/LeaderOntology/vocabulary/activities#> as activities
	extends <http://example.com/LeaderOntology/vocabulary/impacts#> as impacts
	extends <http://example.com/LeaderOntology/vocabulary/decisionProcess#> as decisionProcess
	extends <http://example.com/LeaderOntology/vocabulary/strategies#> as strategies

	concept PerguntaEntrevista < base:EntidadeNomeavel, base:EntidadeIdentificavel, base:EntidadeDescritivel
	concept EvidenciaCHA < base:EntidadeNomeavel, base:EntidadeIdentificavel, base:EntidadeDescritivel
	concept InferenciaDiagnostica < base:EntidadeNomeavel, base:EntidadeIdentificavel, base:EntidadeDescritivel
	concept BlocoEntrevista < base:EntidadeNomeavel, base:EntidadeIdentificavel, base:EntidadeDescritivel
	
	
	scalar NivelMaturidade [
		oneOf "cultura_digital",
		      "atitude_digital",
		      "transformacao_digital"
	]

	scalar property nivelMaturidade [
		domain PerguntaEntrevista
		range NivelMaturidade
		functional
	]

	// Dimensão CHA à qual a evidência se refere
	scalar DimensaoCHA [
		oneOf "CONH", "HAB", "ATI"
	]

	scalar property dimensaoCHA [
		domain EvidenciaCHA
		range DimensaoCHA
		functional
	]

	// Bloco de perfil HPI/Big Five
	scalar BlocoPerfil [
		oneOf "A_conectividade",
		      "B_versatilidade",
		      "C_desenvolvimento",
		      "D_pessoal",
		      "conceitos_ontologia"
	]

	scalar property blocoPerfil [
		domain PerguntaEntrevista
		range BlocoPerfil
		functional
	]


	relation pertenceABloco [
		from PerguntaEntrevista
		to BlocoEntrevista
		reverse contemPergunta
		asymmetric
		irreflexive
	]

	relation temEvidenciaCHA [
		from PerguntaEntrevista
		to EvidenciaCHA
		reverse evidenciaDe
		asymmetric
		irreflexive
	]

	relation temInferencia [
		from PerguntaEntrevista
		to InferenciaDiagnostica
		reverse inferenciaDe
		asymmetric
		irreflexive
	]

	relation avaliaCompetencia [
		from PerguntaEntrevista
		to competencies:Competencia
		reverse competenciaAvaliadaPor
		asymmetric
		irreflexive
	]

	relation revelaConstrutoEstilo [
		from PerguntaEntrevista
		to leadershipStyles:EstiloLideranca
		reverse estiloReveladoPor
		asymmetric
		irreflexive
	]

	relation revelaConstrutoAtividadeChave [
		from PerguntaEntrevista
		to activities:AtividadeChave
		reverse atividadeReveladaPor
		asymmetric
		irreflexive
	]

	relation revelaConstrutoImpacto [
		from PerguntaEntrevista
		to impacts:ImpactoOrganizacional
		reverse impactoReveladoPor
		asymmetric
		irreflexive
	]

	relation revelaConstrutoDecisao [
		from PerguntaEntrevista
		to decisionProcess:ProcessoDecisao
		reverse decisaoReveladaPor
		asymmetric
		irreflexive
	]

	
	relation revelaConstrutoEstrategia [
		from PerguntaEntrevista
		to strategies:Estrategia
		reverse estrategiaReveladaPor
		asymmetric
		irreflexive
	]
	
}